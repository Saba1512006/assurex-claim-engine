{
  "category": "Industrial Tools",
  "policy_name": "Heavy Duty Industrial Equipment & Power Tools Policy",
  "coverage_duration_months": 24,
  "standard_terms_months": [
    24,
    36
  ],
  "extended_extra_months": 12,
  "start_conditions": "Coverage starts on the purchase date shown on the verified invoice.",
  "grace_period_days": 14,
  "claim_reporting_period_days": 30,
  "covered_faults": [
    "Armature burnout",
    "Seal failure",
    "Gearbox seizure",
    "Chuck bearing failure",
    "Trigger switch failure"
  ],
  "excluded_damage_types": [
    "Accidental Drop",
    "Water Ingress"
  ],
  "exclusions": [
    "Tool dropped from height",
    "Submersion in water, slurry or solvent",
    "Overload beyond rated torque",
    "Consumable wear (brushes, chuck teeth, cords)"
  ],
  "exclusion_min_diagnostic_confidence": 0.55,
  "repeat_repair_review_threshold": 2,
  "authorized_service_center_required": true,
  "repair_conditions": "Repairs must be carried out by an authorised service center using genuine parts.",
  "replacement_conditions": "Unit replacement is considered only after a repeated failure of the same component.",
  "mandatory_documents": [
    "receipt"
  ],
  "supporting_documents": [
    "warranty_card",
    "serial_photo",
    "damage_photo"
  ],
  "hard_fail_rules": [
    "WARRANTY_EXPIRED",
    "UNAUTHORIZED_REPAIR",
    "EXCLUDED_DAMAGE",
    "SERIAL_MISMATCH",
    "LATE_REPORTING"
  ],
  "manual_review_rules": [
    "GRACE_PERIOD",
    "EXCLUDED_DAMAGE_UNCONFIRMED",
    "SERIAL_UNVERIFIED",
    "INCOMPLETE_EVIDENCE",
    "UNKNOWN_CAUSE",
    "REPEAT_REPAIRS",
    "PRIOR_REPLACEMENT",
    "UNCOVERED_FAULT"
  ],
  "warning_rules": [
    "NEAR_REPORTING_DEADLINE",
    "WARRANTY_ENDING_SOON",
    "SUPPORTING_DOCUMENT_MISSING"
  ]
}
